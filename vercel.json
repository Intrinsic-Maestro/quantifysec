{
  "builds": [
    {
      "src": "backend/main.py",
      "use": "@vercel/python"
    },
    {
      "src": "frontend/index.html",
      "use": "@vercel/static"
    }
  ],
  "redirects": [
    {
      "source": "/demo",
      "destination": "https://www.youtube.com/watch?v=iDd03MLux1E",
      "permanent": false
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "backend/main.py" },
    { "src": "/(.*)", "dest": "frontend/index.html" }
  ]
}